# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (Postgres + pgvector via docker-compose)
DATABASE_URL="postgresql://postgres:shivam.gaur@127.0.0.1:5432/ai?schema=public"

# Redis (optional — module no-ops if unset)
REDIS_URL=redis://localhost:6379

# JWT / Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma separated phone numbers (E.164) that get the ADMIN role on login.
# This is how the first admin is bootstrapped; everything else uses /admin/users/:id/role.
ADMIN_PHONES=
COOKIE_SECURE=false

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_RATE_LIMIT_MAX=3
OTP_VERIFY_MAX_ATTEMPTS=3
# In development, OTP "123456" is always accepted.
# When NODE_ENV=development, send-otp also returns the OTP in the response body.

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# auto = NODE_ENV development → Gemini chat + Ollama Qwen embeddings
#         NODE_ENV production  → OpenAI chat + OpenAI embeddings
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

GOOGLE_API_KEY=
# Prefer a current Flash model. Slow or unavailable model names look like "timeouts".
GEMINI_MODEL=gemini-2.5-flash
# Wall-clock budgets for LlmService (ms). Gemini + structured JSON often needs >20s.
LLM_TIMEOUT_MS=60000
LLM_STRUCTURED_TIMEOUT_MS=90000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=Qween3-Embedding:latest
OLLAMA_EMBEDDING_DIMENSIONS=1024

# true = re-embed entire corpus on every boot (very slow). Default skips if Qdrant already has vectors.
RAG_SYNC_ON_START=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Empty = career_knowledge_qwen (Ollama 1024-d) or career_knowledge (OpenAI 1536-d)
QDRANT_COLLECTION=
# Dedicated vector store for sarkari catalog + cached notices (never mixed with career_knowledge)
QDRANT_SARKARI_COLLECTION=sarkari_knowledge

# Field ingest: set to 1 to enqueue a syllabus sync once on startup and log every step (development)
FIELD_INGEST_DEBUG=

# Account plan caps (prepPlan FREE vs PAID on User) — resume only; prep skills are unlimited for now
FREE_RESUME_UPLOADS=5
PAID_RESUME_UPLOADS=100

# RabbitMQ — career ingest jobs (API enqueues; worker consumes)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
INGEST_WORKER_CONCURRENCY=3
