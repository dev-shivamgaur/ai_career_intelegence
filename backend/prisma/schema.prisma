generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// App role. USER is a learner. ADMIN can edit the career, job, and exam catalog.
enum Role {
  USER
  ADMIN
}

/// Where the learner is in their career. Used for document rules and seniority.
enum UserStatus {
  STUDENT
  FRESHER
  WORKING_PROFESSIONAL
}

/// Highest schooling stage. Decides which marksheets are required.
enum EducationLevel {
  HIGH_SCHOOL
  INTERMEDIATE
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
}

/// Who wrote the skill onto the profile: the learner, a detector, or a resume extraction.
enum SkillSource {
  USER
  AI_DETECTED
  DOCUMENT
}

/// How close the learner is to a required skill. MISSING means the want-list did not match the resume.
enum SkillStatus {
  STRONG
  GOOD
  NEEDS_IMPROVEMENT
  MISSING
}

/// How urgent a requirement, gap, or roadmap task is.
enum Priority {
  HIGH
  MEDIUM
  LOW
}

/// Whether a career skill is mandatory or only suggested.
enum RequirementType {
  REQUIRED
  RECOMMENDED
  NICE_TO_HAVE
}

/// Progress of a roadmap task or an exam topic.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// Learning window for a roadmap task: first week through six months.
enum RoadmapPhase {
  D7
  D30
  D60
  D90
  D180
}

/// Kind of file the learner uploaded. RESUME skills feed the skill comparison.
enum DocumentType {
  DEGREE
  MARKSHEET
  CERTIFICATE
  RESUME
  OTHER
}

/// Pipeline state while a file is stored and read for skills.
enum DocumentStatus {
  UPLOADING
  PROCESSING
  EXTRACTING
  COMPLETED
  FAILED
}

/// Where a catalog job is performed.
enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

/// Bucket for a user's match percent against one job.
enum JobMatchLabel {
  STRONG
  POTENTIAL
  LOW
}

/// Result of checking a learner against a government opportunity. Not a legal certificate.
enum EligibilityStatus {
  ELIGIBLE
  POSSIBLY_ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_VERIFICATION
}

/// How trustworthy a research source is.
enum SourceQuality {
  OFFICIAL
  TRUSTED
  ESTABLISHED
  COMMUNITY
  UNVERIFIED
}

/// What kind of page a research session saved.
enum SourceType {
  JOB
  LEARNING
  GOVERNMENT
  CAREER_GUIDE
  COMMUNITY
}

/// Lifecycle of one web-research run.
enum ResearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// How the learner prefers to study. Shapes practice prompts.
enum LearningStyle {
  PROJECT
  COURSE
  MIXED
  READING
}

/// Work setting the learner wants. Stored on the profile for later job fit.
enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

/// Kind of work row. JOB or INTERNSHIP with a real employer sets seniority.
enum ExperienceType {
  INTERNSHIP
  JOB
  FREELANCE
  FRESHER
}

/// Why an in-app notification was created.
enum NotificationType {
  ANALYSIS
  OPPORTUNITY
  PROGRESS
  PROFILE
}

/// Who sent a copilot message.
enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Private jobs and skill gaps, or a government exam plan. Sarkari users skip the tech syllabus.
enum CareerTrack {
  PRIVATE_TECH
  GOVERNMENT_EXAM
}

/// Group used to list government exams in the catalog.
enum GovernmentExamCategory {
  SSC
  UPSC
  BANKING
  RAILWAY
  DEFENCE
  STATE
  TEACHING
}

/// Login account. Created by OTP auth, not by a seed file. Owns profile, documents, and goals.
model User {
  id                 String    @id @default(cuid())
  phone              String    @unique
  name               String?
  email              String?   @unique
  avatarInitials     String?
  role               Role      @default(USER)
  isDemo             Boolean   @default(false)
  onboardingComplete Boolean   @default(false)
  /// Preparation engine access. FREE is the default. No payment provider sets this.
  prepPlan           PrepPlan  @default(FREE)
  /// How many resume uploads/replacements this account has used (FREE plan is capped).
  resumeUploadCount  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile            Profile?
  refreshTokens      RefreshToken[]
  documents          Document[]
  careerGoals        CareerGoal[]
  skillGaps          SkillGap[]
  roadmaps           Roadmap[]
  jobMatches         JobMatch[]
  researchSessions   ResearchSession[]
  chatSessions       ChatSession[]
  progressSnapshots  ProgressSnapshot[]
  progressEvents     ProgressEvent[]
  notifications      Notification[]
  governmentElig     GovernmentEligibility[]
  governmentExamPlans GovernmentExamPlan[]
  sarkariMocks       SarkariMockAttempt[]
  personalizedRoadmaps PersonalizedRoadmap[]
  prepSessions       PrepSession[]
  prepUsage          PrepUsage[]

  @@index([phone])
  @@map("user")
}

/// Learner details from onboarding. primaryStack locks the lane (for example nodejs) used in skill comparison.
model Profile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  name                 String
  status               UserStatus        @default(FRESHER)
  educationLevel       EducationLevel    @default(UNDERGRADUATE)
  location             String?
  availableHoursPerDay Int               @default(2)
  learningStyle        LearningStyle     @default(PROJECT)
  remotePreference     RemotePreference  @default(HYBRID)
  careerTrack          CareerTrack       @default(PRIVATE_TECH)
  prepGoalText         String?
  targetExamSlug       String?
  primaryStack         String?
  completionPercent    Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  education            Education[]
  userSkills           UserSkill[]
  certifications       Certification[]
  projects             Project[]
  experience           Experience[]
  skillEvidence        SkillEvidence[]
  evidenceSummaries    SkillEvidenceSummary[]
  githubLinks          GithubRepoLink[]

  @@index([userId])
  @@map("profile")
}

/// One degree or school row on the profile. May be typed by the user or copied from a paper.
model Education {
  id             String         @id @default(cuid())
  profileId      String
  degree         String
  institution    String
  specialization String?
  graduationYear Int?
  level          EducationLevel @default(UNDERGRADUATE)
  scoreLabel     String?
  aiDetected     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  profile        Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education")
}

/// Shared skill name dictionary. One row per unique name, reused by users, careers, and jobs.
model Skill {
  id             String   @id @default(cuid())
  name           String   @unique
  category       String
  /// Market Intelligence: cached normalizeSkillName(name). Not unique until duplicates are merged.
  normalizedName String?
  /// Market Intelligence: controlled domain. category stays as the legacy free-form label.
  domainId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  domain                  SkillDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  aliases                 SkillAlias[]
  userSkills              UserSkill[]
  careerRequirements      CareerSkillRequirement[]
  jobSkills               JobSkill[]
  skillGaps               SkillGap[]
  marketJobSkills         MarketJobSkill[]
  candidatesSuggested     SkillCandidate[] @relation("SkillCandidateSuggested")
  candidatesResolved      SkillCandidate[] @relation("SkillCandidateResolved")
  skillEvidence           SkillEvidence[]
  evidenceSummaries       SkillEvidenceSummary[]
  relationsFrom           SkillRelation[] @relation("SkillRelationFrom")
  relationsTo             SkillRelation[] @relation("SkillRelationTo")
  learningResources       LearningResource[]
  prepPackages            PrepPackage[]
  prepSessions            PrepSession[]

  @@index([category])
  @@index([normalizedName])
  @@index([domainId])
  @@map("skill")
}

/// Controlled skill-domain vocabulary. Admin-managed; AI may only suggest existing keys.
model SkillDomain {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  parentId  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    SkillDomain?  @relation("SkillDomainTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SkillDomain[] @relation("SkillDomainTree")
  skills    Skill[]

  @@map("skill_domain")
}

enum SkillAliasStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Alternate spelling of a skill ("NodeJS" for "Node.js"). Only APPROVED aliases resolve.
model SkillAlias {
  id              String           @id @default(cuid())
  skillId         String
  alias           String
  normalizedAlias String           @unique
  status          SkillAliasStatus @default(APPROVED)
  /// SEED | ADMIN | CANDIDATE
  source          String           @default("SEED")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("skill_alias")
}

/// Market Intelligence tunables (weights, thresholds, retention defaults). Code defaults apply when a key is absent.
model IntelConfig {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("intel_config")
}

/// Append-only audit of IntelConfig changes.
model IntelConfigChange {
  id        String   @id @default(cuid())
  key       String
  version   Int
  oldValue  Json?
  newValue  Json
  changedBy String?
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("intel_config_change")
}

/// A skill this learner has. Resume uploads set source DOCUMENT and proficiency 45. This is the "have" side.
model UserSkill {
  id           String      @id @default(cuid())
  profileId    String
  skillId      String
  proficiency  Int         @default(0)
  source       SkillSource @default(USER)
  status       SkillStatus @default(GOOD)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill        Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([profileId])
  @@map("user_skill")
}

/// Certificate on the profile. Counted as extra evidence in the fit score.
model Certification {
  id         String   @id @default(cuid())
  profileId  String
  name       String
  issuer     String
  year       Int?
  aiDetected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certification")
}

/// Project on the profile. Name and skills are added to the known-skill set during comparison.
model Project {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  description String
  skills      String[]
  year        Int?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("project")
}

/// Work history. A real job or internship raises seniority so lessons skip beginner material.
model Experience {
  id           String         @id @default(cuid())
  profileId    String
  title        String
  organization String
  type         ExperienceType @default(FRESHER)
  summary      String
  startYear    Int?
  endYear      Int?
  isPresent    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experience")
}

/// Uploaded file metadata. The bytes live in storage; this row tracks type and processing status.
model Document {
  id           String         @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String?
  type         DocumentType   @default(OTHER)
  sizeBytes    Int            @default(0)
  storageKey   String
  status       DocumentStatus @default(UPLOADING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction   DocumentExtraction?

  @@index([userId])
  @@index([status])
  @@map("document")
}

/// Facts pulled from one document. skillsDetected is copied onto UserSkill and used as resume evidence.
model DocumentExtraction {
  id              String   @id @default(cuid())
  documentId      String   @unique
  degree          String?
  subjects        Json?
  skillsDetected  String[]
  summary         String?
  suggestedFields Json?
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_extraction")
}

/// Catalog role the admin inserts once (title, slug, coreTopics, stackLanes). Users pick this; they do not create it unless the goal is custom.
model Career {
  id                      String   @id @default(cuid())
  title                   String
  slug                    String   @unique
  overview                String
  marketExpectations      String
  entryLevelExpectations  String
  isCustom                Boolean  @default(false)
  syllabusSlug            String?
  coreTopics              String[] @default([])
  stackLanes              Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  requirements            CareerSkillRequirement[]
  goals                   CareerGoal[]
  roadmaps                Roadmap[]
  ingestJobs              IngestCareerJob[]
  marketProfile           MarketCareerProfile?
  marketJobs              MarketJobCareer[]
  personalizedRoadmaps    PersonalizedRoadmap[]
  prepSessions            PrepSession[]

  @@index([slug])
  @@map("career")
}

/// Want-list for one career. Written when the syllabus syncs. layer CORE or STACK_REQUIRED is what missing skills are judged against. stackLane keeps Node skills off the Java lane.
model CareerSkillRequirement {
  id         String          @id @default(cuid())
  careerId   String
  skillId    String
  importance Priority        @default(MEDIUM)
  type       RequirementType @default(REQUIRED)
  stackLane  String?
  layer      String          @default("CORE")
  /// Provenance: LEGACY | ADMIN | ROADMAP | SEED | LLM. Existing writers do not set it yet (hygiene H8).
  source     String          @default("LEGACY")
  sourceRef  String?
  lastSeenAt DateTime?
  createdAt  DateTime        @default(now())

  career     Career          @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerId, skillId, stackLane])
  @@index([careerId])
  @@index([careerId, stackLane])
  @@map("career_skill_requirement")
}

/// Links one user to the career they chose. Active goal decides which requirement list is compared to the resume. Scores are filled after analysis.
model CareerGoal {
  id               String   @id @default(cuid())
  userId           String
  careerId         String
  isActive         Boolean  @default(true)
  customTitle      String?
  estimatedMatch   Int?
  breakdown        Json?
  whyItMayFit      String[]
  strongAreas      String[]
  missingAreas     String[]
  potentialChallenges String[]
  evidence         Json?
  lastAnalyzedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  career           Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("career_goal")
}

model SkillGap {
  id             String      @id @default(cuid())
  userId         String
  skillId        String
  currentStatus  SkillStatus @default(MISSING)
  required       Boolean     @default(true)
  priority       Priority    @default(MEDIUM)
  estimatedHours Int         @default(10)
  why            Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([priority])
  @@map("skill_gap")
}

model Roadmap {
  id         String   @id @default(cuid())
  userId     String
  careerId   String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  career     Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  tasks      RoadmapTask[]

  @@index([userId])
  @@map("roadmap")
}

model RoadmapTask {
  id                String       @id @default(cuid())
  roadmapId         String
  title             String
  description       String
  why               String?
  priority          Priority     @default(MEDIUM)
  estimatedEffort   String?
  status            TaskStatus   @default(NOT_STARTED)
  relatedSkill      String?
  suggestedResource String?
  phase             RoadmapPhase @default(D30)
  sortOrder         Int          @default(0)
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  roadmap           Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  prepSessions      PrepSession[]

  @@index([roadmapId])
  @@index([status])
  @@map("roadmap_task")
}

model ResearchSession {
  id                 String         @id @default(cuid())
  userId             String
  query              String
  status             ResearchStatus @default(PENDING)
  summary            String?
  sourcesAnalyzed    Int            @default(0)
  jobDescriptions    Int            @default(0)
  learningResources  Int            @default(0)
  governmentSources  Int            @default(0)
  skillPatterns      Int            @default(0)
  verificationStatus String?
  timeline           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources            ResearchSource[]
  findings           ResearchFinding[]

  @@index([userId])
  @@index([status])
  @@map("research_session")
}

model ResearchSource {
  id                   String        @id @default(cuid())
  sessionId            String
  title                String
  type                 SourceType
  domain               String?
  quality              SourceQuality @default(UNVERIFIED)
  keyFinding           String?
  usedInRecommendation Boolean       @default(false)
  confidence           Int           @default(50)
  url                  String?
  createdAt            DateTime      @default(now())

  session              ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("research_source")
}

model ResearchFinding {
  id        String   @id @default(cuid())
  sessionId String
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())

  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("research_finding")
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("knowledge_chunk")
}

model Job {
  id           String   @id @default(cuid())
  company      String
  role         String
  location     String?
  workType     WorkType @default(HYBRID)
  experience   String?
  description  String?
  whyMatches   String?
  priority     Priority @default(MEDIUM)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skills       JobSkill[]
  matches      JobMatch[]

  @@index([isDemo])
  @@index([role])
  @@map("job")
}

model JobSkill {
  id        String  @id @default(cuid())
  jobId     String
  skillId   String
  isMissing Boolean @default(false)

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@map("job_skill")
}

model JobMatch {
  id           String        @id @default(cuid())
  userId       String
  jobId        String
  matchPercent Int
  matchLabel   JobMatchLabel @default(POTENTIAL)
  whyMatches   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("job_match")
}

model GovernmentOpportunity {
  id                   String            @id @default(cuid())
  organization         String
  opportunity          String
  eligibility          String
  ageRequirement       String?
  educationRequirement String?
  location             String?
  deadline             String?
  sourceVerification   String?
  officialNote         String?
  isDemo               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  eligibilities        GovernmentEligibility[]

  @@index([isDemo])
  @@map("government_opportunity")
}

model GovernmentEligibility {
  id           String            @id @default(cuid())
  userId       String
  opportunityId String
  status       EligibilityStatus @default(NEEDS_VERIFICATION)
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity  GovernmentOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("government_eligibility")
}

model GovernmentExam {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  name                  String
  shortName             String
  conductingBody        String
  category              GovernmentExamCategory
  overview              String
  eligibility           String
  ageLimit              String?
  educationRequirement  String?
  examPattern           Json?
  stages                String[]
  officialNote          String?
  isDemo                Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  subjects              GovernmentExamSubject[]
  plans                 GovernmentExamPlan[]
  webSnapshots          SarkariWebSnapshot[]
  mockAttempts          SarkariMockAttempt[]
  knowledgeChunks       SarkariKnowledgeChunk[]

  @@index([category])
  @@index([slug])
  @@map("government_exam")
}

model GovernmentExamSubject {
  id         String   @id @default(cuid())
  examId     String
  name       String
  weightage  String?
  topics     String[]
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  exam       GovernmentExam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  progress   GovernmentExamTopicProgress[]
  mockAttempts SarkariMockAttempt[]

  @@index([examId])
  @@map("government_exam_subject")
}

model GovernmentExamPlan {
  id           String   @id @default(cuid())
  userId       String
  examId       String
  isActive     Boolean  @default(true)
  targetYear   Int?
  dailyMinutes Int      @default(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         GovernmentExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  progress     GovernmentExamTopicProgress[]

  @@unique([userId, examId])
  @@index([userId])
  @@map("government_exam_plan")
}

model GovernmentExamTopicProgress {
  id            String     @id @default(cuid())
  planId        String
  subjectId     String
  topic         String
  status        TaskStatus @default(NOT_STARTED)
  revisedCount  Int        @default(0)
  lastRevisedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan          GovernmentExamPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  subject       GovernmentExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([planId, subjectId, topic])
  @@index([planId])
  @@map("government_exam_topic_progress")
}

model SarkariWebSnapshot {
  id        String   @id @default(cuid())
  examId    String
  url       String
  site      String
  title     String
  excerpt   String   @db.Text
  kind      String   @default("news")
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  exam      GovernmentExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, url])
  @@index([examId])
  @@index([site])
  @@map("sarkari_web_snapshot")
}

model SarkariMockAttempt {
  id           String   @id @default(cuid())
  userId       String
  examId       String
  subjectId    String?
  scorePercent Int
  takenAt      DateTime @default(now())
  note         String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         GovernmentExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject      GovernmentExamSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, examId])
  @@index([examId])
  @@map("sarkari_mock_attempt")
}

model SarkariKnowledgeChunk {
  id        String   @id @default(cuid())
  examId    String?
  title     String
  content   String   @db.Text
  source    String?
  sourceUrl String?
  kind      String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam      GovernmentExam? @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([kind])
  @@map("sarkari_knowledge_chunk")
}

model ProgressSnapshot {
  id                     String   @id @default(cuid())
  userId                 String
  skillsCompleted        Int      @default(0)
  skillsTotal            Int      @default(0)
  roadmapPercent         Int      @default(0)
  learningHours          Int      @default(0)
  projectsCompleted      Int      @default(0)
  applications           Int      @default(0)
  interviewPrepPercent   Int      @default(0)
  skillProgressOverTime  Json?
  applicationsOverTime   Json?
  roadmapCompletionOverTime Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("progress_snapshot")
}

model ProgressEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("progress_event")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_session")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_message")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notification")
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  jti              String    @unique
  familyId         String
  fingerprintHash  String
  userAgent        String?
  replacedByHash   String?
  revoked          Boolean   @default(false)
  reusedAt         DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// One admin or scheduler batch that fans out into per-career ingest jobs.
enum IngestRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum IngestTrigger {
  SCHEDULER
  ADMIN
  CREATE
}

enum IngestJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IngestStepStatus {
  RUNNING
  COMPLETED
  FAILED
}

model IngestRun {
  id            String          @id @default(cuid())
  trigger       IngestTrigger
  status        IngestRunStatus @default(QUEUED)
  startedAt     DateTime?
  finishedAt    DateTime?
  totalJobs     Int             @default(0)
  completedJobs Int             @default(0)
  failedJobs    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  jobs          IngestCareerJob[]

  @@index([createdAt])
  @@map("ingest_run")
}

model IngestCareerJob {
  id         String          @id @default(cuid())
  runId      String
  careerId   String
  status     IngestJobStatus @default(QUEUED)
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  run   IngestRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  career Career         @relation(fields: [careerId], references: [id], onDelete: Cascade)
  steps IngestJobStep[]

  @@index([runId])
  @@index([careerId, createdAt])
  @@map("ingest_career_job")
}

model IngestJobStep {
  id         String           @id @default(cuid())
  jobId      String
  stepKey    String
  status     IngestStepStatus
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  meta       Json?
  error      String?

  job IngestCareerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ingest_job_step")
}

// ---------------------------------------------------------------------------
// Market Intelligence (additive). Separate from the curated Job / JobSkill catalog.
// ---------------------------------------------------------------------------

enum MarketSourceType {
  GREENHOUSE
  LEVER
  ASHBY
}

/// What learners may see from a source. Raw text is always admin-only.
enum MarketDisplayPolicy {
  SNIPPET_AND_LINK
  LINK_ONLY
  NONE
}

/// robots.txt is a crawl-policy signal only. UNKNOWN (missing or unreachable) is never treated as permission.
enum RobotsStatus {
  ALLOWED
  DISALLOWED
  UNKNOWN
}

enum MarketRunKind {
  FETCH
  PROCESS
  AGGREGATE
  RETENTION
}

enum MarketTrigger {
  SCHEDULER
  ADMIN
}

enum MarketRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum MarketTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Admin-curated employer. One company can have boards on several ATS providers.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  website   String?
  country   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources   MarketSource[]
  jobs      MarketJob[]

  @@map("company")
}

/// One public ATS board. Cannot be enabled without a recorded, unexpired terms review.
model MarketSource {
  id                       String              @id @default(cuid())
  companyId                String
  type                     MarketSourceType
  boardToken               String
  label                    String?
  enabled                  Boolean             @default(false)
  crawlIntervalHours       Int                 @default(24)

  termsUrl                 String?
  termsReviewedAt          DateTime?
  termsReviewedBy          String?
  termsSummary             String?
  /// ANALYTICS_AGGREGATE | DISPLAY_SNIPPET | DISPLAY_LINK_ONLY
  allowedUses              String[]            @default([])
  attributionRequired      Boolean             @default(false)
  termsReviewDueAt         DateTime?

  storeRawPayload          Boolean             @default(false)
  rawPayloadRetentionDays  Int?
  descriptionRetentionDays Int?
  evidenceExcerptMaxChars  Int?
  displayPolicy            MarketDisplayPolicy @default(LINK_ONLY)

  robotsStatus             RobotsStatus        @default(UNKNOWN)
  robotsCheckedAt          DateTime?
  lastFetchAt              DateTime?
  lastSuccessAt            DateTime?
  lastError                String?
  consecutiveFailures      Int                 @default(0)
  pausedReason             String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks                    MarketTask[]
  rawJobs                  MarketRawJob[]

  @@unique([type, boardToken])
  @@index([companyId])
  @@index([enabled])
  @@map("market_source")
}

/// One fan-out batch (fetch, process, aggregate or retention). Mirrors IngestRun without touching it.
model MarketRun {
  id             String          @id @default(cuid())
  kind           MarketRunKind
  trigger        MarketTrigger
  status         MarketRunStatus @default(QUEUED)
  /// Scheduler window key, e.g. "2026-10-09-fetch". Authoritative dedupe because Redis may be in-memory.
  windowKey      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  totalTasks     Int             @default(0)
  completedTasks Int             @default(0)
  failedTasks    Int             @default(0)
  counters       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tasks          MarketTask[]

  @@index([kind, createdAt])
  @@index([windowKey])
  @@map("market_run")
}

/// One queue message. taskId makes redelivery idempotent.
model MarketTask {
  id         String           @id @default(cuid())
  runId      String
  kind       MarketRunKind
  sourceId   String?
  careerId   String?
  status     MarketTaskStatus @default(QUEUED)
  attempts   Int              @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  error      String?
  counters   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  run        MarketRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  source     MarketSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([sourceId, createdAt])
  @@map("market_task")
}

enum MarketListingStatus {
  OPEN
  CLOSED
  STALE
}

/// Pipeline checkpoint. A retry resumes from the last completed stage.
enum MarketProcessingStatus {
  PENDING
  NORMALIZED
  DEDUPED
  EXTRACTED
  CLASSIFIED
  DONE
  SKIPPED
  FAILED
}

/// One posting exactly as a board returned it. Raw text is admin-only and purged per the source retention policy;
/// metadata, contentHash and downstream structured rows are kept.
model MarketRawJob {
  id                 String                 @id @default(cuid())
  sourceId           String
  externalId         String
  rawTitle           String
  rawLocation        String?
  rawDescription     String?                @db.Text
  rawPayload         Json?
  rawPayloadStoredAt DateTime?
  url                String?
  department         String?
  employmentType     String?
  workplaceType      String?
  contentHash        String
  sourcePostedAt     DateTime?
  sourceUpdatedAt    DateTime?
  firstSeenAt        DateTime               @default(now())
  lastSeenAt         DateTime               @default(now())
  closedAt           DateTime?
  listingStatus      MarketListingStatus    @default(OPEN)
  processingStatus   MarketProcessingStatus @default(PENDING)
  processorVersion   String?
  processingError    String?
  contentPurgedAt    DateTime?
  /// Set by cross-source dedupe; many raw rows can point at one MarketJob.
  marketJobId        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  source             MarketSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  marketJob          MarketJob?             @relation(fields: [marketJobId], references: [id], onDelete: SetNull)
  skills             MarketJobSkill[]

  @@unique([sourceId, externalId])
  @@index([processingStatus])
  @@index([sourceId, listingStatus])
  @@index([lastSeenAt])
  @@index([marketJobId])
  @@map("market_raw_job")
}

enum MarketSeniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
  LEAD
  MANAGER
}

enum MarketEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

/// One real-world vacancy after normalization and cross-source dedupe. Demand counts each MarketJob once.
model MarketJob {
  id                 String                @id @default(cuid())
  companyId          String
  title              String
  normalizedTitle    String
  seniority          MarketSeniority?
  workType           WorkType?
  locationText       String?
  countries          String[]              @default([])
  isRemote           Boolean               @default(false)
  experienceMinYears Int?
  experienceMaxYears Int?
  employmentType     MarketEmploymentType?
  postedAt           DateTime?
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  closedAt           DateTime?
  status             MarketListingStatus   @default(OPEN)
  /// Bottom-k sketch of hashed description shingles; survives the raw-text purge so dedupe keeps working.
  shingleSketch      Int[]                 @default([])
  primaryRawJobId    String?
  sourceCount        Int                   @default(1)
  normalizerVersion  String
  classificationStatus MarketClassificationStatus @default(PENDING)
  classifierVersion  String?
  classifiedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawJobs            MarketRawJob[]
  skills             MarketJobSkill[]
  careers            MarketJobCareer[]

  @@index([classificationStatus])
  @@index([companyId, normalizedTitle])
  @@index([status, lastSeenAt])
  @@index([firstSeenAt])
  @@map("market_job")
}

enum MarketSkillMethod {
  RULE
  LLM
  RULE_LLM
}

/// One skill a posting asks for. Structured fields are kept forever; the evidence excerpt follows the source retention policy.
model MarketJobSkill {
  id               String            @id @default(cuid())
  marketJobId      String
  rawJobId         String
  rawName          String
  normalizedName   String
  skillId          String?
  /// EXACT | NORMALIZED | ALIAS | LEXICON | NONE (unresolved, waiting for review)
  resolveMethod    String
  level            RequirementType
  confidence       Float
  method           MarketSkillMethod
  /// Excerpt containing the match, validated against the description at extraction time.
  evidence         String?
  evidenceStart    Int?
  evidenceEnd      Int?
  yearsRequired    Int?
  extractorVersion String
  createdAt        DateTime          @default(now())

  marketJob        MarketJob         @relation(fields: [marketJobId], references: [id], onDelete: Cascade)
  rawJob           MarketRawJob      @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  skill            Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([rawJobId, normalizedName])
  @@index([skillId])
  @@index([marketJobId])
  @@index([normalizedName])
  @@map("market_job_skill")
}

enum SkillCandidateStatus {
  PENDING
  APPROVED
  MAPPED
  REJECTED
  MERGED
}

/// A skill name seen in postings that no Skill or approved alias resolves. Counts are recomputed, never incremented.
model SkillCandidate {
  id               String               @id @default(cuid())
  name             String
  normalizedName   String               @unique
  status           SkillCandidateStatus @default(PENDING)
  jobCount         Int                  @default(0)
  companyCount     Int                  @default(0)
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  suggestedSkillId String?
  /// EMBEDDING | LLM
  suggestionMethod String?
  suggestionScore  Float?
  resolvedSkillId  String?
  autoApproved     Boolean              @default(false)
  reviewedBy       String?
  reviewedAt       DateTime?
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  suggestedSkill   Skill?               @relation("SkillCandidateSuggested", fields: [suggestedSkillId], references: [id], onDelete: SetNull)
  resolvedSkill    Skill?               @relation("SkillCandidateResolved", fields: [resolvedSkillId], references: [id], onDelete: SetNull)

  @@index([status, jobCount])
  @@map("skill_candidate")
}

/// Audit trail of skill review decisions and merges (who, what, before/after counts).
model SkillReviewLog {
  id            String   @id @default(cuid())
  /// APPROVE_NEW | MAP_ALIAS | REJECT | REOPEN | AUTO_MAP | ADD_ALIAS | DISABLE_ALIAS | MERGE_SKILL
  action        String
  candidateId   String?
  skillId       String?
  targetSkillId String?
  actorId       String?
  details       Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([candidateId])
  @@map("skill_review_log")
}

enum MarketClassificationStatus {
  PENDING
  CLASSIFIED
  UNCLASSIFIED
}

enum MarketClassifyMethod {
  TITLE_PATTERN
  SKILL_OVERLAP
  LLM
  ADMIN
}

/// Market-side settings for a career, kept off the Career row so existing career responses are unchanged.
model MarketCareerProfile {
  id              String   @id @default(cuid())
  careerId        String   @unique
  /// Plain phrases matched on word boundaries against the normalized job title.
  titlePatterns   String[] @default([])
  excludePatterns String[] @default([])
  enabled         Boolean  @default(true)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  career          Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@map("market_career_profile")
}

/// Which career (and lane) a market job counts toward. laneKey "all" keeps the unique key free of NULLs.
model MarketJobCareer {
  id                String               @id @default(cuid())
  marketJobId       String
  careerId          String
  laneKey           String               @default("all")
  confidence        Float
  method            MarketClassifyMethod
  isPrimary         Boolean              @default(false)
  matchedPattern    String?
  classifierVersion String
  createdAt         DateTime             @default(now())

  marketJob         MarketJob            @relation(fields: [marketJobId], references: [id], onDelete: Cascade)
  career            Career               @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([marketJobId, careerId, laneKey])
  @@index([careerId, laneKey])
  @@map("market_job_career")
}

enum MarketPeriodType {
  WEEK
  MONTH
}

/// NEW_POSTINGS: firstSeenAt inside the period (trends). ACTIVE_STOCK: open at any time in the period (display only).
enum MarketDemandBasis {
  NEW_POSTINGS
  ACTIVE_STOCK
}

/// Sources with at least one successful fetch inside a period. Only their companies' jobs count for that period.
model MarketPanelMembership {
  id                String           @id @default(cuid())
  periodType        MarketPeriodType
  periodStart       DateTime
  periodEnd         DateTime
  sourceId          String
  companyId         String
  successfulFetches Int
  firstSuccessAt    DateTime
  lastSuccessAt     DateTime
  computedAt        DateTime         @default(now())

  @@unique([periodType, periodStart, sourceId])
  @@index([periodType, periodStart])
  @@map("market_panel_membership")
}

/// Population behind one career (or lane) demand figure. Complete periods are written once; the open period is
/// replaced on each aggregation until it closes. No foreign keys, so history survives skill merges.
model MarketCareerSnapshot {
  id                 String            @id @default(cuid())
  periodType         MarketPeriodType
  periodStart        DateTime
  periodEnd          DateTime
  basis              MarketDemandBasis
  careerId           String
  laneKey            String            @default("all")
  methodologyVersion String
  isComplete         Boolean
  totalJobs          Int
  cappedTotal        Float
  companyCount       Int
  capJobs            Int
  panelSources       Int
  panelCompanies     Int
  /// Thresholds used (classification and skill confidence, company cap share).
  params             Json
  computedAt         DateTime          @default(now())

  @@unique([periodType, periodStart, basis, careerId, laneKey, methodologyVersion])
  @@index([careerId, laneKey, periodType, basis, periodStart])
  @@map("market_career_snapshot")
}

/// One skill's demand inside a career (or lane) for one period and basis. demandPct = cappedJobCount / cappedTotal;
/// wilsonLower/Upper are the 95% Wilson interval on that share with n = cappedTotal.
model MarketSkillSnapshot {
  id                 String            @id @default(cuid())
  periodType         MarketPeriodType
  periodStart        DateTime
  periodEnd          DateTime
  basis              MarketDemandBasis
  careerId           String
  laneKey            String            @default("all")
  skillId            String
  skillName          String
  methodologyVersion String
  isComplete         Boolean
  jobCount           Int
  requiredCount      Int
  preferredCount     Int
  niceCount          Int
  companyCount       Int
  cappedJobCount     Float
  totalJobs          Int
  cappedTotal        Float
  demandPct          Float
  wilsonLower        Float
  wilsonUpper        Float
  panelCompanies     Int
  computedAt         DateTime          @default(now())

  @@unique([periodType, periodStart, basis, careerId, laneKey, skillId, methodologyVersion])
  @@index([careerId, laneKey, periodType, basis, periodStart])
  @@index([skillId])
  @@map("market_skill_snapshot")
}

enum SkillTrendLabel {
  INCREASING
  DECREASING
  EMERGING
  STABLE
  INSUFFICIENT_DATA
}

/// Disjoint NEW_POSTINGS comparison on the intersection panel of consecutive periods. Old rows are never relabelled;
/// a methodology change bumps methodologyVersion and writes new rows.
model SkillTrend {
  id                 String           @id @default(cuid())
  periodType         MarketPeriodType
  /// Later period of the compared pair (or of the confirmation window's end).
  periodStart        DateTime
  periodEnd          DateTime
  priorPeriodStart   DateTime
  priorPeriodEnd     DateTime
  careerId           String
  laneKey            String           @default("all")
  skillId            String
  skillName          String
  methodologyVersion String
  /// Always NEW_POSTINGS; stored so readers do not have to know the rule.
  basis              MarketDemandBasis @default(NEW_POSTINGS)
  label              SkillTrendLabel
  panelCompanies     Int
  panelSources       Int
  jobCount           Float
  priorJobCount      Float
  totalJobs          Float
  priorTotalJobs     Float
  share              Float
  priorShare         Float
  /// Absolute change in share (percentage points as a fraction, e.g. 0.05 = +5 pp).
  effectPp           Float
  relativeGrowth     Float?
  pValue             Float?
  adjustedPValue     Float?
  confirmedSteps     Int              @default(0)
  companies          Int
  priorCompanies     Int
  params             Json
  computedAt         DateTime         @default(now())

  @@unique([periodType, periodStart, careerId, laneKey, skillId, methodologyVersion])
  @@index([careerId, laneKey, periodType, periodStart])
  @@index([skillId])
  @@index([label])
  @@map("skill_trend")
}

enum EvidenceSource {
  RESUME
  PROJECT
  ASSESSMENT
  GITHUB
  MANUAL
}

enum EvidenceQuality {
  MENTIONED
  DEMONSTRATED
  ASSESSED
}

enum EvidenceClaim {
  CLAIMED
  SUPPORTED
  VERIFIED
}

/// One observation of a skill. A re-upload or rescan adds a row and marks the previous current row of that source as not current.
model SkillEvidence {
  id             String          @id @default(cuid())
  profileId      String
  skillId        String
  source         EvidenceSource
  sourceRef      String?
  observedAt     DateTime        @default(now())
  quality        EvidenceQuality
  signal         String?
  current        Boolean         @default(true)
  supersededById String?
  createdAt      DateTime        @default(now())

  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([profileId, skillId, current])
  @@index([profileId, source])
  @@map("skill_evidence")
}

/// Best current claim for a skill. History stays on SkillEvidence.
model SkillEvidenceSummary {
  id        String        @id @default(cuid())
  profileId String
  skillId   String
  status    EvidenceClaim
  updatedAt DateTime      @updatedAt

  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("skill_evidence_summary")
}

/// A public GitHub repo the learner linked. Disconnect sets revokedAt and keeps evidence rows.
model GithubRepoLink {
  id           String    @id @default(cuid())
  profileId    String
  owner        String
  repo         String
  url          String
  revokedAt    DateTime?
  lastScannedAt DateTime?
  createdAt    DateTime  @default(now())

  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, owner, repo])
  @@index([profileId])
  @@map("github_repo_link")
}

enum SkillRelationKind {
  PREREQUISITE
}

/// relatedSkill should be learned before skill. Used only by the readiness view.
model SkillRelation {
  id             String            @id @default(cuid())
  skillId        String
  relatedSkillId String
  kind           SkillRelationKind @default(PREREQUISITE)
  createdAt      DateTime          @default(now())

  skill          Skill             @relation("SkillRelationFrom", fields: [skillId], references: [id], onDelete: Cascade)
  related        Skill             @relation("SkillRelationTo", fields: [relatedSkillId], references: [id], onDelete: Cascade)

  @@unique([skillId, relatedSkillId, kind])
  @@index([skillId])
  @@map("skill_relation")
}

model PersonalizedRoadmap {
  id        String                    @id @default(cuid())
  userId    String
  careerId  String
  title     String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  career    Career                    @relation(fields: [careerId], references: [id], onDelete: Cascade)
  tasks     PersonalizedRoadmapTask[]

  @@index([userId])
  @@map("personalized_roadmap")
}

model PersonalizedRoadmapTask {
  id          String               @id @default(cuid())
  roadmapId   String
  skillId     String?
  title       String
  why         String
  sortOrder   Int                  @default(0)
  foundational Boolean             @default(false)
  createdAt   DateTime             @default(now())

  roadmap     PersonalizedRoadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@map("personalized_roadmap_task")
}

enum LearningResourceKind {
  DOC
  TUTORIAL
  PRACTICE
}

model LearningResource {
  id        String               @id @default(cuid())
  skillId   String
  title     String
  url       String
  kind      LearningResourceKind
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())

  skill     Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, active])
  @@map("learning_resource")
}

/// Learner access to preparation quotas. Not a billing subscription.
enum PrepPlan {
  FREE
  PAID
}

enum PrepPackageStatus {
  DRAFT
  PUBLISHED
}

enum PrepSessionStatus {
  IN_PROGRESS
  NEEDS_PRACTICE
  VERIFIED
  ABANDONED
}

enum PrepLessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PrepUsageKind {
  GENERATE
  GRADE
  HINT
}

/// Shared, versioned lesson package for one skill. Rubric stays off learner responses.
model PrepPackage {
  id          String            @id @default(cuid())
  skillId     String
  /// "*" is the generic package. A career id scopes a package to that career.
  careerScope String            @default("*")
  version     Int
  content     Json
  rubric      Json
  contentHash String
  status      PrepPackageStatus @default(PUBLISHED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  skill       Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sessions    PrepSession[]

  @@unique([skillId, careerScope, version])
  @@index([skillId, status])
  @@map("prep_package")
}

/// One learner's run of a package. Progress is not shared with other users.
model PrepSession {
  id            String            @id @default(cuid())
  userId        String
  skillId       String
  careerId      String?
  packageId     String
  roadmapTaskId String?
  status        PrepSessionStatus @default(IN_PROGRESS)
  resumeState   Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill         Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  career        Career?           @relation(fields: [careerId], references: [id], onDelete: SetNull)
  package       PrepPackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  roadmapTask   RoadmapTask?      @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)
  lessons       PrepLessonProgress[]
  attempts      PrepAttempt[]
  tasks         PrepTaskSubmission[]

  @@index([userId, skillId, status])
  @@index([packageId])
  @@map("prep_session")
}

model PrepLessonProgress {
  id          String           @id @default(cuid())
  sessionId   String
  lessonKey   String
  status      PrepLessonStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  session     PrepSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, lessonKey])
  @@map("prep_lesson_progress")
}

/// Append-only answer. A package update does not rewrite these rows.
model PrepAttempt {
  id             String   @id @default(cuid())
  sessionId      String
  questionKey    String
  attemptNumber  Int
  answer         String
  score          Int
  maxScore       Int      @default(100)
  feedback       String
  passed         Boolean
  idempotencyKey String
  createdAt      DateTime @default(now())

  session        PrepSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, questionKey])
  @@map("prep_attempt")
}

model PrepTaskSubmission {
  id         String   @id @default(cuid())
  sessionId  String
  taskKey    String
  evidence   String
  verified   Boolean  @default(false)
  score      Int      @default(0)
  feedback   String
  createdAt  DateTime @default(now())

  session    PrepSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, taskKey])
  @@map("prep_task_submission")
}

model PrepUsage {
  id        String        @id @default(cuid())
  userId    String
  kind      PrepUsageKind
  model     String?
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("prep_usage")
}
